# Copiar a .env y completar antes de levantar el servidor.
GEMINI_API_KEY=

# Modelo Live (ASR streaming) y modelo de texto usado para traducir cada
# oración ya transcripta. Ver README para alternativas/validación.
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash

# Orígenes permitidos para llamar a la API REST desde JS de otro dominio
# (para que una conferencia integre esto en su propio sitio). "*" = todos.
# Ejemplo restringido: https://miconferencia.com,https://otra-conf.com
CORS_ALLOWED_ORIGINS=*

# Token compartido requerido para crear/cerrar salas (POST /api/rooms,
# DELETE /api/rooms/{id}), vía el header "X-Admin-Token". Vacío = sin
# autenticación (cómodo para desarrollar local, pero cualquiera que
# encuentre la URL pública puede crear salas y gastar la cuota de Gemini).
# Generar uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
